# run_hls.tcl — Vivado HLS / Vitis HLS project script.
#
# STATUS: NOT run. No Vivado/Vitis HLS installation exists in this dev
# environment. This script is prepared for when the project moves to a
# machine that has the toolchain — see ../README.md for the full status
# and required steps before trusting anything synthesized from it.
#
# Usage (on a machine with Vivado HLS / Vitis HLS installed):
#   vivado_hls -f run_hls.tcl        (2019.x-era toolchain)
#   vitis_hls -f run_hls.tcl         (2020.2+ toolchain)

open_project ema_det_gates_prj
set_top ema_det_gates_forward

add_files ema_det_gates.cpp -cflags "-DHLS_TARGET -I."
add_files -tb main_tb.cpp -cflags "-DHLS_TARGET -I."
add_files -tb reference_io.csv
# add_files -tb <input_test_*.bin files generated by export_hls_weights.py>

open_solution "solution1"
# Zynq-7020 (paper's stated target device, e.g. ZC706/PYNQ-Z2-class part).
# Confirm the exact part number/speed grade against the actual board before
# synthesis — this is a placeholder, not verified against real hardware.
set_part {xc7z020clg484-1}
create_clock -period 10 -name default

# 1. C simulation FIRST — validates ema_det_gates.cpp against
#    reference_io.csv in float, before spending time on synthesis.
csim_design

# 2. C synthesis — only meaningful once step 1 passes.
csynth_design

# 3. C/RTL co-simulation — validates the *synthesized* (ap_fixed) datapath
#    against the same reference values. Given hls_types.h's ap_fixed<16,6>
#    is an unvalidated starting point, expect to revisit precision here.
cosim_design

# 4. Export IP only after the above are all clean.
# export_design -format ip_catalog

exit
